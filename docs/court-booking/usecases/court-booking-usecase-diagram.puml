@startuml
left to right direction
skinparam packageStyle rectangle

actor "Người chơi" as NguoiChoi
actor "Nhà cung cấp sân" as NhaCungCapSan

rectangle "Badminton Community & Marketplace Platform" {
  package "Tìm sân và booking" {
    usecase "Tìm sân bằng danh sách\nvà bản đồ" as UC_TimSanDanhSachBanDo
    usecase "Lọc và sắp xếp sân" as UC_LocSapXepSan
    usecase "Xem chi tiết cơ sở sân" as UC_XemChiTietCoSoSan
    usecase "Xem lịch trống\nvà giá hiện hành" as UC_XemLichTrongVaGia
    usecase "Chọn slot và thời lượng\nđặt sân" as UC_ChonSlotVaThoiLuong
    usecase "Giữ slot trong 10 phút" as UC_GiuSlot
    usecase "Tạo booking đặt sân" as UC_TaoBooking
    usecase "Xem chi tiết và\nlịch sử booking" as UC_XemBooking
    usecase "Hủy booking" as UC_HuyBooking
    usecase "Điều chỉnh hoặc hủy booking\ndo phía sân" as UC_DieuChinhBookingDoPhiaSan
  }
}

NguoiChoi -- UC_TimSanDanhSachBanDo
NguoiChoi -- UC_LocSapXepSan
NguoiChoi -- UC_XemChiTietCoSoSan
NguoiChoi -- UC_XemLichTrongVaGia
NguoiChoi -- UC_ChonSlotVaThoiLuong
NguoiChoi -- UC_GiuSlot
NguoiChoi -- UC_TaoBooking
NguoiChoi -- UC_XemBooking
NguoiChoi -- UC_HuyBooking

NhaCungCapSan -- UC_DieuChinhBookingDoPhiaSan

UC_TaoBooking ..> UC_GiuSlot : <<include>>
UC_TaoBooking ..> UC_ChonSlotVaThoiLuong : <<include>>
@enduml
