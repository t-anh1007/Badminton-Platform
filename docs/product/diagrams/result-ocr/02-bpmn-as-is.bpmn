<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_AsIs" targetNamespace="http://courtin.local/bpmn">
<bpmn:collaboration id="Collab_Proc_AsIs"><bpmn:participant id="Pool_Proc_AsIs" name="AS-IS — Khai kết quả kèo và tranh chấp (hiện tại)" processRef="Proc_AsIs"/></bpmn:collaboration>
<bpmn:process id="Proc_AsIs" isExecutable="false">
<bpmn:laneSet id="LaneSet_Proc_AsIs">
<bpmn:lane id="L_ck" name="Chủ kèo"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>B1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_dt" name="Người chơi còn lại"><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>B2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ht" name="Hệ thống"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>GM</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_cs" name="Chủ sân"><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>B3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ad" name="Admin"><bpmn:flowNodeRef>T7</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Hết giờ sân"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="S_def"/></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Mở cửa sổ khai 12h, nhắc chủ kèo"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T2" name="Nhập tỉ số từng set kèm 1–3 ảnh"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T3" name="Mở 12h phản hồi, báo đối thủ"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T4" name="Xem kết quả: Đồng ý hoặc Phản đối"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="Phản hồi?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T5" name="Khóa tiền tạm giữ và điểm, mở tranh chấp"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T6" name="Xem bằng chứng, đề xuất kết quả (24h)"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T7" name="Quyết định kết quả (SLA 48h), xác nhận 2 bước"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GM" name=""><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T9" name="Chia tiền tạm giữ, cập nhật rating và BXH"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Kết quả final"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T8" name="Tạm Không có kết quả, mở 12h báo sự cố"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Final Không có kết quả (50:50)"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="B1" name="Hết 12h không khai" attachedToRef="T2"><bpmn:outgoing>f13</bpmn:outgoing><bpmn:timerEventDefinition id="B1_def"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B2" name="Hết 12h không phản hồi" attachedToRef="T4"><bpmn:outgoing>f15</bpmn:outgoing><bpmn:timerEventDefinition id="B2_def"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B3" name="Hết 24h" attachedToRef="T6"><bpmn:outgoing>f16</bpmn:outgoing><bpmn:timerEventDefinition id="B3_def"/></bpmn:boundaryEvent>
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2"/>
<bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="T3"/>
<bpmn:sequenceFlow id="f4" sourceRef="T3" targetRef="T4"/>
<bpmn:sequenceFlow id="f5" sourceRef="T4" targetRef="G1"/>
<bpmn:sequenceFlow id="f6" name="Đồng ý" sourceRef="G1" targetRef="GM"/>
<bpmn:sequenceFlow id="f7" name="Phản đối" sourceRef="G1" targetRef="T5"/>
<bpmn:sequenceFlow id="f8" sourceRef="T5" targetRef="T6"/>
<bpmn:sequenceFlow id="f9" sourceRef="T6" targetRef="T7"/>
<bpmn:sequenceFlow id="f10" sourceRef="T7" targetRef="GM"/>
<bpmn:sequenceFlow id="f11" sourceRef="GM" targetRef="T9"/>
<bpmn:sequenceFlow id="f12" sourceRef="T9" targetRef="E1"/>
<bpmn:sequenceFlow id="f13" sourceRef="B1" targetRef="T8"/>
<bpmn:sequenceFlow id="f14" sourceRef="T8" targetRef="E2"/>
<bpmn:sequenceFlow id="f15" sourceRef="B2" targetRef="GM"/>
<bpmn:sequenceFlow id="f16" sourceRef="B3" targetRef="T7"/>
</bpmn:process>
