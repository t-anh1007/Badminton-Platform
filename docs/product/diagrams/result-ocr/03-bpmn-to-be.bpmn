<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_ToBe" targetNamespace="http://courtin.local/bpmn">
<bpmn:collaboration id="Collab_Proc_ToBe"><bpmn:participant id="Pool_Proc_ToBe" name="TO-BE — Quét ảnh tỉ số, tự chốt kết quả" processRef="Proc_ToBe"/></bpmn:collaboration>
<bpmn:process id="Proc_ToBe" isExecutable="false">
<bpmn:laneSet id="LaneSet_Proc_ToBe">
<bpmn:lane id="L_nk" name="Người chơi đội đề xuất"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>B1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_dc" name="Người chơi đội còn lại"><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>B2</bpmn:flowNodeRef><bpmn:flowNodeRef>B3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ht" name="Hệ thống"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2b</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>SP</bpmn:flowNodeRef><bpmn:flowNodeRef>GF</bpmn:flowNodeRef><bpmn:flowNodeRef>TF</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ai" name="AI agent"><bpmn:flowNodeRef>T3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ad" name="Admin"><bpmn:flowNodeRef>TA</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Hết giờ sân"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="S_def"/></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Mở cửa sổ khai 12h, nhắc cả roster"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T2" name="Chụp hoặc tải ảnh bảng tỉ số"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T2b" name="Tạm Không có kết quả, mở 12h báo sự cố"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Final Không có kết quả (50:50)"><bpmn:incoming>f24</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T3" name="Đọc ảnh: tỉ số, cột, độ chắc"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="T4" name="Kiểm tra luật, giờ chụp, trùng ảnh; xếp mức"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:userTask id="T5" name="Xác nhận hoặc sửa, bấm Gửi"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="T6" name="Lập kết quả đề xuất, mở cửa sổ theo mức"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G1" name="Mức Đỏ (ảnh lạ)?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T7" name="Phản hồi kết quả đề xuất"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G2" name="Phản hồi?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G3" name="Kèo đôi?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T8" name="Người còn lại xác nhận (grace 1h)"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G4" name="Người còn lại?"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:subProcess id="SP" name="Tranh chấp tỉ số (xem 03b)"><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:subProcess>
<bpmn:userTask id="TA" name="Xử hồ sơ, ra kết quả cuối (SLA 48h)"><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GF" name=""><bpmn:incoming>f14</bpmn:incoming><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:incoming>f25</bpmn:incoming><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="TF" name="Chốt: chia tiền tạm giữ, rating, điểm BXH"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Kết quả final"><bpmn:incoming>f22</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="B1" name="Hết 12h không ai khai" attachedToRef="T2"><bpmn:outgoing>f23</bpmn:outgoing><bpmn:timerEventDefinition id="B1_def"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B2" name="Hết cửa sổ 2h/6h/12h" attachedToRef="T7"><bpmn:outgoing>f25</bpmn:outgoing><bpmn:timerEventDefinition id="B2_def"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="B3" name="Hết 1h" attachedToRef="T8"><bpmn:outgoing>f26</bpmn:outgoing><bpmn:timerEventDefinition id="B3_def"/></bpmn:boundaryEvent>
