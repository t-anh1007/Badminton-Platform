<bpmn:sequenceFlow id="f18" name="Có" sourceRef="G7" targetRef="TA"/>
<bpmn:sequenceFlow id="f19" sourceRef="TA" targetRef="GE"/>
<bpmn:sequenceFlow id="f20" sourceRef="GE" targetRef="E"/>
<bpmn:sequenceFlow id="f21" sourceRef="B4" targetRef="GE"/>
</bpmn:process>
