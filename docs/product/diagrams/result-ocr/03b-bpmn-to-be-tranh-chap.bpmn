<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_ToBe_Dispute" targetNamespace="http://courtin.local/bpmn">
<bpmn:collaboration id="Collab_Proc_ToBe_Dispute"><bpmn:participant id="Pool_Proc_ToBe_Dispute" name="TO-BE — Tiến trình con: Tranh chấp tỉ số hai tầng" processRef="Proc_ToBe_Dispute"/></bpmn:collaboration>
<bpmn:process id="Proc_ToBe_Dispute" isExecutable="false">
<bpmn:laneSet id="LaneSet_Proc_ToBe_Dispute">
<bpmn:lane id="L_pl" name="Người chơi hai đội"><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>T16</bpmn:flowNodeRef><bpmn:flowNodeRef>B4</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ht" name="Hệ thống"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>IT1</bpmn:flowNodeRef><bpmn:flowNodeRef>GX</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>G5</bpmn:flowNodeRef><bpmn:flowNodeRef>G6</bpmn:flowNodeRef><bpmn:flowNodeRef>GM2</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>G7</bpmn:flowNodeRef><bpmn:flowNodeRef>GE</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ai" name="AI agent"><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>T14</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ad" name="Admin"><bpmn:flowNodeRef>TA</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Bất đồng tỉ số"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="T10" name="Mở 2h nộp bằng chứng (giữ kín)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T11" name="Nộp ảnh bằng chứng"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="IT1" name="Hết 2h hoặc đã nộp đủ"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:timerEventDefinition id="IT1_def"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T12" name="Đọc ảnh bằng chứng"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GX" name="Đọc được hết?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="T13" name="Tầng 1: gom bằng chứng theo bên thắng"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G5" name="Ủng hộ mấy bên?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T14" name="Tầng 2: phán quyết tạm (RAG luật + án lệ)"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G6" name="Tin cậy ≥ 0,85?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GM2" name=""><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T15" name="Công bố kết quả tạm, mở 6h kháng nghị"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="T16" name="Bên bị xử thua: chấp nhận hoặc kháng nghị"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G7" name="Kháng nghị có căn cứ?"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="TA" name="Xử hồ sơ, ra kết quả cuối (SLA 48h)"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GE" name=""><bpmn:incoming>f17</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E" name="Có kết quả cuối"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="B4" name="Hết 6h" attachedToRef="T16"><bpmn:outgoing>f21</bpmn:outgoing><bpmn:timerEventDefinition id="B4_def"/></bpmn:boundaryEvent>
