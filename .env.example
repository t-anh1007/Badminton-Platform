# ---------------------------------------------------------------------------
# Khoaluantn — biến môi trường mẫu (copy sang .env cho local dev)
# Hạ tầng local do docker-compose.infrastructure.yml cung cấp:
#   PostgreSQL (5432), Redis (6379), RabbitMQ (5672 / management 15672)
# Mô hình: schema-per-service trong MỘT Postgres. Mỗi service nghiệp vụ có
# một schema riêng + một role riêng chỉ có quyền trên schema của mình (D17).
# api-gateway là proxy thuần — KHÔNG có Postgres.
# ---------------------------------------------------------------------------

# --- Postgres (superuser, chỉ dùng cho init/quản trị local) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=khoaluantn
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres

# --- Connection string mỗi service nghiệp vụ (dùng role riêng, trỏ schema riêng) ---
# Định dạng: postgresql://<role>:<pw>@host:port/db?schema=<schema>
ACCOUNT_DATABASE_URL=postgresql://account_svc:account_pw@localhost:5432/khoaluantn?schema=account
VENUE_BOOKING_DATABASE_URL=postgresql://venue_booking_svc:venue_booking_pw@localhost:5432/khoaluantn?schema=venue_booking
FINANCE_DATABASE_URL=postgresql://finance_svc:finance_pw@localhost:5432/khoaluantn?schema=finance
MATCHMAKING_DATABASE_URL=postgresql://matchmaking_svc:matchmaking_pw@localhost:5432/khoaluantn?schema=matchmaking
COMMUNITY_DATABASE_URL=postgresql://community_svc:community_pw@localhost:5432/khoaluantn?schema=community
COMMUNITY_TEST_DATABASE_URL=postgresql://community_svc:community_pw@localhost:5432/khoaluantn?schema=community_test

# --- Hạ tầng dùng chung ---
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- S3-compatible object storage (MinIO local) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=khoaluantn-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Để trống thì API tạo signed GET URL 10 phút; đặt URL public khi bucket/CDN công khai.
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Bucket private riêng cho ảnh bằng chứng kết quả kèo và chứng từ trả thưởng.
# Không bật public access/custom domain; chỉ đọc qua signed URL.
OBJECT_STORAGE_PRIVATE_BUCKET=khoaluantn-private

# --- Cổng mỗi service (local) ---
GATEWAY_PORT=3000
ACCOUNT_PORT=3001
VENUE_BOOKING_PORT=3002
FINANCE_PORT=3003
MATCHMAKING_PORT=3004
COMMUNITY_PORT=3005

# --- api-gateway ---
# Bí mật xác thực JWT — GĐ1 mới là skeleton, giá trị thật đặt ở G1.
JWT_SECRET=change-me-in-real-env
# Secret chia sẻ bắt buộc giữa Finance, Matchmaking và Venue cho lệnh ghi D39.
# Không dùng giá trị mẫu này ở môi trường triển khai.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
# Đích proxy nội bộ (gateway trỏ tới các service)
ACCOUNT_SERVICE_URL=http://localhost:3001
VENUE_BOOKING_SERVICE_URL=http://localhost:3002
FINANCE_SERVICE_URL=http://localhost:3003
MATCHMAKING_SERVICE_URL=http://localhost:3004
COMMUNITY_SERVICE_URL=http://localhost:3005
# Relay outbox gọi các URL này sau mỗi lần publish để đánh thức consumer đang ngủ
# (Railway serverless). Production: đặt ở account/venue-booking/matchmaking =
# http://finance-service.railway.internal:3003/health. Local không cần.
# EVENT_WAKE_URLS=

# Origin frontend được phép gọi trực tiếp các service từ browser. Có thể khai
# báo nhiều origin, phân tách bằng dấu phẩy, cho preview/production Vercel.
WEB_ORIGIN=http://localhost:5173

# Vercel/Vite production: đặt URL public của service khi không có rewrite
# same-origin. Local dev/preview đã có proxy mặc định nên không cần hai biến này.
VITE_VENUE_BOOKING_URL=http://localhost:3002
VITE_FINANCE_URL=http://localhost:3003
VITE_ACCOUNT_URL=http://localhost:3001

# --- Email giao dịch ---
# Production Railway dùng Gmail API qua cổng 443 vì SMTP outbound có thể bị chặn.
# GMAIL_FROM phải là mailbox hoặc alias đã được OAuth account xác minh.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
EMAIL_FROM=${GMAIL_FROM}
# SMTP vẫn được hỗ trợ làm fallback khi Gmail API chưa cấu hình.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- AI quét ảnh tỉ số / tranh chấp tự động (matchmaking-service) ---
# Xem docs/architecture/result-ocr-tech-design.md §2, §8. Chỉ nguồn miễn phí; thiếu key thì bỏ qua mắt xích đó.
# RESULT_AI_ENABLED=false: người chơi gõ tay (tối đa Vàng), tầng 2 chuyển Admin.
RESULT_AI_ENABLED=true
AI_OCR_CHAIN=gemini:gemini-3.5-flash-lite,cloudflare:@cf/meta/llama-4-scout-17b-16e-instruct,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3.5-super-vl:free
AI_RULING_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
AI_EMBEDDING=gemini:gemini-embedding-2:768
AI_JUDGE=groq:openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Provider bổ sung: cloudflare:@cf/... (cần thêm CLOUDFLARE_ACCOUNT_ID), ollama:<model> (vd ollama:gpt-oss:120b).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
OLLAMA_API_KEY=
AI_CALL_TIMEOUT_MS=12000
AI_RULING_TIMEOUT_MS=90000
AI_OCR_BUDGET_MS=30000
OCR_CELL_CONFIDENCE=0.9
RULING_CONFIDENCE_THRESHOLD=0.85
RESULT_WINDOWS=green:2h,yellow:6h,red:12h,grace:1h,evidence:2h,appeal:6h
