# ---------------------------------------------------------------------------
# Khoaluantn — biến môi trường mẫu (copy sang .env cho local dev)
# Hạ tầng local do docker-compose.infrastructure.yml cung cấp:
#   PostgreSQL (5432), Redis (6379), RabbitMQ (5672 / management 15672)
# Mô hình: schema-per-service trong MỘT Postgres. Mỗi service nghiệp vụ có
# một schema riêng + một role riêng chỉ có quyền trên schema của mình (D17).
# api-gateway là proxy thuần — KHÔNG có Postgres.
# ---------------------------------------------------------------------------

# --- Postgres (superuser, chỉ dùng cho init/quản trị local) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=khoaluantn
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres

# --- Connection string mỗi service nghiệp vụ (dùng role riêng, trỏ schema riêng) ---
# Định dạng: postgresql://<role>:<pw>@host:port/db?schema=<schema>
ACCOUNT_DATABASE_URL=postgresql://account_svc:account_pw@localhost:5432/khoaluantn?schema=account
VENUE_BOOKING_DATABASE_URL=postgresql://venue_booking_svc:venue_booking_pw@localhost:5432/khoaluantn?schema=venue_booking
FINANCE_DATABASE_URL=postgresql://finance_svc:finance_pw@localhost:5432/khoaluantn?schema=finance
MATCHMAKING_DATABASE_URL=postgresql://matchmaking_svc:matchmaking_pw@localhost:5432/khoaluantn?schema=matchmaking
COMMUNITY_DATABASE_URL=postgresql://community_svc:community_pw@localhost:5432/khoaluantn?schema=community

# --- Hạ tầng dùng chung ---
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Cổng mỗi service (local) ---
GATEWAY_PORT=3000
ACCOUNT_PORT=3001
VENUE_BOOKING_PORT=3002
FINANCE_PORT=3003
MATCHMAKING_PORT=3004
COMMUNITY_PORT=3005

# --- api-gateway ---
# Bí mật xác thực JWT — GĐ1 mới là skeleton, giá trị thật đặt ở G1.
JWT_SECRET=change-me-in-real-env
# Đích proxy nội bộ (gateway trỏ tới các service)
ACCOUNT_SERVICE_URL=http://localhost:3001
VENUE_BOOKING_SERVICE_URL=http://localhost:3002
FINANCE_SERVICE_URL=http://localhost:3003
MATCHMAKING_SERVICE_URL=http://localhost:3004
COMMUNITY_SERVICE_URL=http://localhost:3005

# Origin frontend được phép gọi trực tiếp các service từ browser. Có thể khai
# báo nhiều origin, phân tách bằng dấu phẩy, cho preview/production Vercel.
WEB_ORIGIN=http://localhost:5173
