{
  "name": "@khoaluantn/matchmaking-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "prisma:generate": "cd ../.. && dotenv -e .env -- prisma generate --schema services/matchmaking-service/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "postinstall": "prisma generate",
    "test": "dotenv -e ../../.env -v OUTBOX_RELAY_INTERVAL_MS=200 -- vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@khoaluantn/ai": "^0.1.0",
    "@khoaluantn/eventbus": "^0.1.0",
    "@khoaluantn/shared": "^0.1.0",
    "@prisma/client": "^5.22.0",
    "amqplib": "^2.0.1",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
