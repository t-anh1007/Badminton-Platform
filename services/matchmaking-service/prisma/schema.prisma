// matchmaking-service — Prisma schema (schema-per-service, D17/ADR 0004).
// P2-G0: lược đồ theo docs/architecture/data-model-phase-2.md §1.
// Bất biến: service này CHỈ định nghĩa/đụng tới schema "matchmaking" của chính nó;
// không FK, không model tham chiếu bảng của service khác.

generator client {
  provider = "prisma-client-js"
  // Bắt buộc output riêng — tránh service khác ghi đè client khi hoist (xem
  // ghi chú trong account-service/prisma/schema.prisma, phát hiện lúc làm G1).
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("MATCHMAKING_DATABASE_URL")
}

enum MatchSourceType {
  hold
  paid_booking
}

enum MatchMode {
  friendly
  ranked
}

enum MatchDiscipline {
  singles
  doubles
}

/// Bên thua : bên thắng.
enum MatchRatio {
  five_five
  six_four
  seven_three
}

enum MatchFormat {
  bo3
  bo5
}

enum TeamSide {
  A
  B
}

enum MatchStatus {
  /// PLAN_MATCH-DEPOSIT: đã tạo kèo, chờ chủ kèo trả cọc — chưa list công khai,
  /// chưa cho đối join. Trả cọc xong -> open.
  awaiting_deposit
  open
  filled
  confirmed
  completed
  cancelled
}

enum JoinStatus {
  pending
  approved
  rejected
  confirmed
  withdrawn
  /// BR-CM-72..76: slot Team A chủ kèo đã trả thay, chưa có partner vào đội.
  reserved
}

/// D39 logical actions are persisted before the caller invokes the venue
/// command. This is a local saga receipt, not a foreign key to venue data.
enum MatchResolutionAction {
  withdraw
  cancel
}

enum MatchResolutionDecision {
  pending
  confirmed
  held_revoked
  cancelled
}

enum EvaluationReviewStatus {
  pending
  approved
  rejected
}

enum SkillTier {
  newcomer
  beginner
  intermediate
  intermediate_plus
  advanced
}

model Match {
  businessCode                String            @unique @default(dbgenerated("('KEO-'::text || lpad((nextval('matches_business_code_seq'::regclass))::text, 8, '0'::text))"))
  id                          String            @id @default(uuid())
  organizerUserId             String
  bookingId                   String            @unique
  capacity                    Int
  feePerSlot                  BigInt
  skillMin                    SkillTier?
  skillMax                    SkillTier?
  skillConfiguredAt           DateTime?         @db.Timestamptz(3)
  status                      MatchStatus       @default(open)
  cutoffAt                    DateTime          @db.Timestamptz(3)
  /// PLAN_MATCH-DEPOSIT: hạn tìm đối X (find-opponent deadline). Scheduler tự
  /// hủy kèo chưa confirmed khi quá hạn này. Nullable cho bản ghi legacy.
  deadlineAt                  DateTime?         @db.Timestamptz(3)
  organizerContributionPaidAt DateTime?         @db.Timestamptz(3)
  organizerContributionId     String?           @unique
  fundingRequestedAt          DateTime?         @db.Timestamptz(3)
  settlementAttemptId         String?           @unique
  settlementVenueRevision     Int               @default(0)
  completedAt                 DateTime?         @db.Timestamptz(3)
  /// Kèo cạnh tranh v2 (competitive-matches.md BR-CM-01..09). Cấu hình khóa khi công bố.
  sourceType                  MatchSourceType   @default(hold)
  mode                        MatchMode         @default(friendly)
  discipline                  MatchDiscipline   @default(singles)
  ratio                       MatchRatio        @default(five_five)
  format                      MatchFormat       @default(bo3)
  /// Snapshot từ Venue lúc tạo; null cho kèo cũ không backfill được xuyên service.
  bookingPrice                BigInt?
  startAt                     DateTime?         @db.Timestamptz(3)
  endAt                       DateTime?         @db.Timestamptz(3)
  venueId                     String?
  provinceCode                String?
  providerUserId              String?
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)
  joins                       Join[]
  partnerInvites              PartnerInvite[]
  evaluations                 Evaluation[]
  resolutions                 MatchResolution[]
  resultCase                  MatchResultCase?

  @@index([status, cutoffAt])
  @@index([mode, discipline, status, startAt])
  @@index([provinceCode, mode, discipline])
  @@map("matches")
}

model MatchResolution {
  commandId     String                  @id
  matchId       String
  joinId        String?
  action        MatchResolutionAction
  cancelReason  String?
  attemptId     String?
  venueRevision Int
  decision      MatchResolutionDecision @default(pending)
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  resolvedAt    DateTime?               @db.Timestamptz(3)
  match         Match                   @relation(fields: [matchId], references: [id])

  @@index([matchId, action, decision])
  @@map("match_resolutions")
}

model Join {
  id                    String     @id @default(uuid())
  matchId               String
  participantUserId     String
  status                JoinStatus @default(pending)
  feePaidAt             DateTime?  @db.Timestamptz(3)
  approvedAt            DateTime?  @db.Timestamptz(3)
  paymentContributionId String?    @unique
  /// Đội đã chọn trước khi trả tiền; null cho JOIN cũ.
  teamSide              TeamSide?
  /// BR-CM-72: chủ kèo trả thay slot Team A cho partner; null = người chơi tự trả.
  payerUserId           String?
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  match                 Match      @relation(fields: [matchId], references: [id])

  @@index([matchId, status])
  @@index([matchId, teamSide, status])
  @@map("joins")
}

/// Kết quả kèo v2 (competitive-matches.md BR-CM-23..42). Claim/response/quyết định
/// append-only (trigger DB chặn UPDATE/DELETE); chỉ status/version của case được tiến.
enum ResultCaseStatus {
  declaration_open
  provisional
  incident_window
  provider_review
  admin_review
  final
  // Quét ảnh tỉ số / tranh chấp hai tầng (result-ocr-autoconfirm.md §8), chỉ hồ sơ rulesVersion=ra_v1.
  proposed
  acceptance_grace
  evidence_window
  rule_ruling
  ai_ruling
  appeal_window
}

/// T8: hồ sơ mở trước khi triển khai giữ luật cũ tới khi đóng.
enum ResultRulesVersion {
  legacy
  ra_v1
}

enum ResultLevel {
  green
  yellow
  red
}

enum MatchOutcome {
  TEAM_A_WIN
  TEAM_B_WIN
  NO_RESULT
}

enum ResultResponseKind {
  confirm
  object
  incident
  /// BR-RA-30: đội đã nộp đủ bằng chứng tranh chấp.
  evidence_done
}

enum ResultIncidentType {
  no_show
  not_played
  interrupted
  other
}

model MatchResultCase {
  id                     String                   @id @default(uuid())
  matchId                String                   @unique
  match                  Match                    @relation(fields: [matchId], references: [id])
  status                 ResultCaseStatus         @default(declaration_open)
  outcome                MatchOutcome?
  declarationDeadlineAt  DateTime                 @db.Timestamptz(3)
  objectionDeadlineAt    DateTime?                @db.Timestamptz(3)
  teamGraceDeadlineAt    DateTime?                @db.Timestamptz(3)
  incidentDeadlineAt     DateTime?                @db.Timestamptz(3)
  providerDeadlineAt     DateTime?                @db.Timestamptz(3)
  adminReviewStartedAt   DateTime?                @db.Timestamptz(3)
  adminNextReminderAt    DateTime?                @db.Timestamptz(3)
  /// Đã nhắc sắp hết hạn khai báo / phản hồi (spec §11); chống gửi trùng khi scheduler chạy lại.
  declarationReminderAt  DateTime?                @db.Timestamptz(3)
  responseReminderAt     DateTime?                @db.Timestamptz(3)
  rulesVersion           ResultRulesVersion       @default(ra_v1)
  /// BR-RA-20a: lưu cả hạn gốc và hạn đã giãn qua đêm.
  responseDeadlineBaseAt DateTime?                @db.Timestamptz(3)
  responseDeadlineAt     DateTime?                @db.Timestamptz(3)
  graceDeadlineAt        DateTime?                @db.Timestamptz(3)
  evidenceDeadlineAt     DateTime?                @db.Timestamptz(3)
  evidenceClosedAt       DateTime?                @db.Timestamptz(3)
  appealDeadlineAt       DateTime?                @db.Timestamptz(3)
  /// Tầng 2 đang chờ AI (BR-RA-37): thử lại tới rulingRetryUntil rồi chuyển Admin.
  pendingRuling          Boolean                  @default(false)
  rulingRetryUntil       DateTime?                @db.Timestamptz(3)
  version                Int                      @default(1)
  finalizedAt            DateTime?                @db.Timestamptz(3)
  closedAt               DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  claims                 ResultClaim[]
  responses              ResultResponse[]
  evidence               ResultEvidence[]
  recommendations        ProviderRecommendation[]
  adminDecision          AdminResultDecision?
  uploads                ResultUpload[]
  rulings                AiRuling[]
  appeals                ResultAppeal[]

  @@index([status, declarationDeadlineAt])
  @@index([status, objectionDeadlineAt])
  @@index([closedAt])
  @@map("match_result_cases")
}

model ResultClaim {
  id                String           @id @default(uuid())
  caseId            String
  claimantUserId    String
  outcome           MatchOutcome
  setWinsA          Int
  setWinsB          Int
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  /// ra_v1: mọi cột dưới đây ghi lúc chèn, không bao giờ sửa (trigger chỉ ghi thêm giữ nguyên, T6).
  level             ResultLevel?
  levelReasons      Json?
  columnMappedBy    String?
  editedCells       Json?
  manualEntry       Boolean          @default(false)
  supersedesClaimId String?
  draftId           String?
  /// `claim` = bản khai; `evidence` = ảnh nộp trong 2h tranh chấp (BR-RA-30).
  purpose           String           @default("claim")
  case              MatchResultCase  @relation(fields: [caseId], references: [id])
  sets              ResultSet[]
  evidence          ResultEvidence[]

  @@index([caseId, createdAt])
  @@map("result_claims")
}

model ResultSet {
  id       String      @id @default(uuid())
  claimId  String
  position Int
  teamA    Int
  teamB    Int
  claim    ResultClaim @relation(fields: [claimId], references: [id])

  @@unique([claimId, position])
  @@map("result_sets")
}

model ResultResponse {
  id           String              @id @default(uuid())
  caseId       String
  userId       String
  kind         ResultResponseKind
  incidentType ResultIncidentType?
  reason       String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  case         MatchResultCase     @relation(fields: [caseId], references: [id])
  evidence     ResultEvidence[]

  @@index([caseId, createdAt])
  @@map("result_responses")
}

model ResultEvidence {
  id                 String          @id @default(uuid())
  caseId             String
  objectKey          String          @unique
  mimeType           String
  size               Int
  checksumSha256     String
  ownerUserId        String
  claimId            String?
  responseId         String?
  position           Int
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  /// Retention xóa binary 90 ngày sau closedAt; metadata/checksum giữ lại (BR-CM-27).
  deletedAt          DateTime?       @db.Timestamptz(3)
  /// ra_v1: ghi lúc chèn, không sửa. purpose: claim / evidence / appeal.
  uploadId           String?
  capturedAt         DateTime?       @db.Timestamptz(3)
  dhash              String?
  exactDuplicateOfId String?
  nearDuplicateOfId  String?
  level              ResultLevel?
  levelReasons       Json?
  /// Bên thắng mà ảnh ủng hộ, theo bản khai/bản nộp chứa ảnh (BR-RA-30).
  supports           MatchOutcome?
  purpose            String          @default("claim")
  case               MatchResultCase @relation(fields: [caseId], references: [id])
  claim              ResultClaim?    @relation(fields: [claimId], references: [id])
  response           ResultResponse? @relation(fields: [responseId], references: [id])

  @@unique([caseId, objectKey])
  @@index([caseId, ownerUserId])
  @@index([checksumSha256])
  @@map("result_evidence")
}

/// Ảnh nháp trước khi gửi bản khai (chỉ ghi thêm); chưa tính vào hạn mức 7 ảnh.
model ResultUpload {
  id                 String            @id @default(uuid())
  caseId             String
  userId             String
  /// Id của lượt tải (id ResultUpload đầu tiên trong lượt).
  draftId            String
  objectKey          String            @unique
  checksumSha256     String
  mimeType           String
  size               Int
  capturedAt         DateTime?         @db.Timestamptz(3)
  capturedAtSource   String
  dhash              String
  exactDuplicateOfId String?
  nearDuplicateOfId  String?
  isScreenshot       Boolean           @default(false)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  case               MatchResultCase   @relation(fields: [caseId], references: [id])
  readings           EvidenceReading[]

  @@index([caseId, userId])
  @@index([draftId])
  @@map("result_uploads")
}

/// Mỗi lượt AI đọc một ảnh (thành công hoặc thất bại); đọc lại là dòng mới.
model EvidenceReading {
  id         String       @id @default(uuid())
  uploadId   String
  ok         Boolean
  reading    Json?
  provider   String?
  model      String?
  chainIndex Int?
  latencyMs  Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  upload     ResultUpload @relation(fields: [uploadId], references: [id])

  @@index([uploadId, createdAt])
  @@map("evidence_readings")
}

/// Kết quả tạm tầng 1 (luật) và phán quyết tạm tầng 2 (AI) — BR-RA-31..40.
model AiRuling {
  id           String          @id @default(uuid())
  caseId       String
  tier         Int
  outcome      MatchOutcome
  reasons      Json
  adminNotes   String?
  citations    Json
  confidence   Float?
  provider     String?
  model        String?
  latencyMs    Int?
  tokensIn     Int?
  tokensOut    Int?
  publishedAt  DateTime?       @db.Timestamptz(3)
  appealedAt   DateTime?       @db.Timestamptz(3)
  finalOutcome MatchOutcome?
  overturned   Boolean?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  case         MatchResultCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("ai_rulings")
}

model ResultAppeal {
  id            String          @id @default(uuid())
  caseId        String
  rulingId      String
  userId        String
  reason        String
  pointedReason String?
  evidenceIds   Json
  accepted      Boolean
  adminGrounded Boolean?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  case          MatchResultCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("result_appeals")
}

/// BR-RA-51: tối đa 1 vi phạm/người/hồ sơ; uy tín = đếm 90 ngày lúc đọc.
model PlayerViolation {
  id        String   @id @default(uuid())
  userId    String
  caseId    String
  kind      String
  source    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, caseId])
  @@index([userId, createdAt])
  @@map("player_violations")
}

/// Kho RAG (tech design §7). `tsv` là cột sinh `to_tsvector('simple', text)` tạo bằng SQL thô trong migration.
model KnowledgeChunk {
  id        String                   @id
  kind      String
  ref       String
  text      String
  embedding Float[]
  tsv       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, text)"))
  metadata  Json                     @default("{}")
  active    Boolean                  @default(true)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([kind, active])
  @@index([tsv], type: Gin)
  @@map("knowledge_chunks")
}

/// Mỗi lần gọi AI (không chứa prompt) — chỉ số "rơi xuống nguồn dự phòng" (spec §10).
model AiCallLog {
  id         String   @id @default(uuid())
  purpose    String
  provider   String
  model      String
  chainIndex Int
  ok         Boolean
  errorCode  String?
  latencyMs  Int
  tokensIn   Int?
  tokensOut  Int?
  caseId     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([purpose, createdAt])
  @@map("ai_call_logs")
}

model ProviderRecommendation {
  id             String          @id @default(uuid())
  caseId         String
  providerUserId String
  outcome        MatchOutcome
  reason         String
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  case           MatchResultCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("provider_recommendations")
}

model AdminResultDecision {
  id          String          @id @default(uuid())
  caseId      String          @unique
  adminUserId String
  outcome     MatchOutcome
  reason      String
  caseVersion Int
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  case        MatchResultCase @relation(fields: [caseId], references: [id])

  @@map("admin_result_decisions")
}

/// BR-CM-44: mỗi user có hai rating state độc lập, singles và doubles.
model Passport {
  userId        String
  discipline    MatchDiscipline
  declaredTier  SkillTier?
  ratingMu      Float
  ratingRd      Float
  ratingSigma   Float
  matchesPlayed Int             @default(0)
  declaredAt    DateTime?       @db.Timestamptz(3)
  /// BR-CM-49: mốc rating period gần nhất (đánh trận hoặc tăng RD khi không hoạt động).
  lastAgedAt    DateTime?       @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@id([userId, discipline])
  @@map("passports")
}

/// BR-CM-43..48: mỗi kết quả ranked đổi rating của mỗi người đúng một lần.
model MatchRatingChange {
  id           String          @id @default(uuid())
  matchId      String
  userId       String
  discipline   MatchDiscipline
  ratingBefore Float
  ratingAfter  Float
  delta        Float
  /// Thắng trận này; dùng cho tiêu chí nhiều trận thắng/chuỗi thắng của chương trình thưởng.
  won          Boolean         @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([matchId, userId, discipline])
  @@index([userId, discipline, createdAt])
  @@map("match_rating_changes")
}

/// BR-CM-47: suất rating cùng đối thủ trong 7 ngày trượt, quyết định theo finalizedAt lúc chốt kết quả.
/// opponentKey: singles = userId đối thủ; doubles = hai userId đội đối phương đã sắp xếp, nối bằng ':'.
model RatedEncounter {
  id             String          @id @default(uuid())
  matchId        String
  userId         String
  discipline     MatchDiscipline
  opponentKey    String
  finalizedAt    DateTime        @db.Timestamptz(3)
  rated          Boolean
  /// Kết quả đã giữ suất (snapshot đối thủ lúc chốt); consumer áp theo thứ tự finalizedAt.
  opponentRating Float?
  opponentRd     Float?
  score          Float?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([matchId, userId])
  @@index([userId, discipline, opponentKey, finalizedAt])
  @@map("rated_encounters")
}

/// BR-CM-55..60: lịch kỳ toàn nền tảng; trạng thái suy ra từ thời gian và closedAt.
model Season {
  id        String                @id @default(uuid())
  name      String
  startAt   DateTime              @db.Timestamptz(3)
  endAt     DateTime              @db.Timestamptz(3)
  closedAt  DateTime?             @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)
  profiles  PlayerSeasonProfile[]
  stats     SeasonStat[]
  badges    PlayerBadge[]

  @@index([startAt, endAt])
  @@map("seasons")
}

/// BR-CM-59: tỉnh/thành chính của người chơi, khóa tới hết kỳ.
model PlayerSeasonProfile {
  seasonId     String
  userId       String
  provinceCode String
  lockedAt     DateTime @db.Timestamptz(3)
  season       Season   @relation(fields: [seasonId], references: [id])

  @@id([seasonId, userId])
  @@map("player_season_profiles")
}

/// Không chuyên = Yếu, TB; Chuyên = TB+, Bán chuyên. Mới chơi không chơi được kèo xếp hạng.
enum SeasonDivision {
  amateur
  pro
}

/// BR-CM-56/57: số liệu theo kỳ, reset mỗi kỳ; Passport giữ nguyên qua các kỳ.
model SeasonStat {
  seasonId         String
  userId           String
  discipline       MatchDiscipline
  matchesPlayed    Int             @default(0)
  wins             Int             @default(0)
  provinceMatches  Int             @default(0)
  currentWinStreak Int             @default(0)
  longestWinStreak Int             @default(0)
  ratingGain       Float           @default(0)
  /// Hạng đấu khóa ở trận xếp hạng đầu tiên của mùa (điểm kinh nghiệm >= 1600 → pro).
  division         SeasonDivision?
  /// Điểm BXH mùa (Elo K=40, sàn 0), tách khỏi điểm kinh nghiệm và reset mỗi mùa.
  points           Int             @default(0)
  /// Chụp lúc đóng kỳ để BXH/huy hiệu kỳ đã đóng không đổi theo Passport hiện tại.
  finalRating      Float?
  finalRd          Float?
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  season           Season          @relation(fields: [seasonId], references: [id])

  @@id([seasonId, userId, discipline])
  @@index([seasonId, discipline, matchesPlayed])
  @@map("season_stats")
}

/// BR-CM-62..70: chương trình thưởng Admin; tiền từ ngân sách riêng, không đụng ví/quỹ kèo.
enum RewardCriterion {
  ending_rating
  most_wins
  largest_rating_gain
  longest_streak
}

enum RewardProgramStatus {
  draft
  scheduled
  active
  reconciling
  awaiting_admin_approval
  final
  cancelled
}

model RewardProgram {
  id               String              @id @default(uuid())
  name             String
  seasonId         String
  criterion        RewardCriterion
  discipline       MatchDiscipline
  band             String
  scope            String
  provinceCode     String?
  startAt          DateTime            @db.Timestamptz(3)
  endAt            DateTime            @db.Timestamptz(3)
  status           RewardProgramStatus @default(draft)
  createdByUserId  String
  approvedByUserId String?
  publishedAt      DateTime?           @db.Timestamptz(3)
  cancelledAt      DateTime?           @db.Timestamptz(3)
  cancelReason     String?
  finalizedAt      DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  tiers            RewardTier[]
  awards           RewardAward[]

  @@index([status, startAt])
  @@map("reward_programs")
}

model RewardTier {
  id        String        @id @default(uuid())
  programId String
  rank      Int
  amount    BigInt
  program   RewardProgram @relation(fields: [programId], references: [id])

  @@unique([programId, rank])
  @@map("reward_tiers")
}

model RewardAward {
  id        String        @id @default(uuid())
  programId String
  userId    String
  rank      Int
  score     Float
  amount    BigInt
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  program   RewardProgram @relation(fields: [programId], references: [id])

  @@unique([programId, userId])
  @@map("reward_awards")
}

/// Huy hiệu vĩnh viễn; provinceCode '' cho phạm vi toàn nền tảng để unique key không vướng NULL.
model PlayerBadge {
  id           String          @id @default(uuid())
  userId       String
  discipline   MatchDiscipline
  seasonId     String
  badgeType    String
  scope        String
  provinceCode String          @default("")
  awardedAt    DateTime        @default(now()) @db.Timestamptz(3)
  season       Season          @relation(fields: [seasonId], references: [id])

  @@unique([userId, discipline, seasonId, badgeType, scope, provinceCode])
  @@index([userId, awardedAt])
  @@map("player_badges")
}

/// BR-CM-54: audit mỗi lần Admin duyệt sửa khai báo qua support ticket (mỗi ticket áp dụng một lần).
model PassportCorrection {
  id             String          @id @default(uuid())
  ticketId       String          @unique
  userId         String
  discipline     MatchDiscipline
  adminUserId    String
  approvedTier   SkillTier
  previousRating Float?
  newRating      Float
  matchesPlayed  Int
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, discipline])
  @@map("passport_corrections")
}

model Evaluation {
  id               String                  @id @default(uuid())
  matchId          String
  raterUserId      String
  rateeUserId      String
  perceivedTier    SkillTier?
  labels           Json?
  flagged          Boolean                 @default(false)
  flagReason       String?
  countedAt        DateTime?               @db.Timestamptz(3)
  reviewStatus     EvaluationReviewStatus?
  reviewedAt       DateTime?               @db.Timestamptz(3)
  reviewedByUserId String?
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  match            Match                   @relation(fields: [matchId], references: [id])

  @@unique([matchId, raterUserId, rateeUserId])
  @@index([matchId, flagged])
  @@index([raterUserId, rateeUserId, perceivedTier, createdAt])
  @@map("evaluations")
}

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt     DateTime? @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)

  @@index([publishedAt, claimedAt, createdAt])
  @@map("outbox")
}

model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("processed_events")
}

enum PartnerPayMode {
  self
  organizer
}

enum PartnerInviteStatus {
  pending
  accepted
  declined
  cancelled
}

/// BR-CM-71..78: lời mời partner vào slot Team A kèo đôi; hết hiệu lực tại cutoffAt của kèo.
model PartnerInvite {
  id            String              @id @default(uuid())
  matchId       String
  inviteeUserId String
  payMode       PartnerPayMode
  status        PartnerInviteStatus @default(pending)
  /// Trả thay: null tới khi khoản của chủ kèo thanh toán xong (BR-CM-72).
  sentAt        DateTime?           @db.Timestamptz(3)
  respondedAt   DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  match         Match               @relation(fields: [matchId], references: [id])

  @@index([matchId, status])
  @@index([inviteeUserId, status])
  @@map("partner_invites")
}
