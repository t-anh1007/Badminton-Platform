// account-service — Prisma schema (schema-per-service, D17/ADR 0004).
// G0: áp lược đồ theo docs/architecture/data-model.md §1 + decision-log.md §5.
// Bất biến: service này CHỈ định nghĩa/đụng schema "account" của chính nó;
// không FK, không model tham chiếu bảng của service khác.
// Token blacklist (đăng xuất/thu hồi) để ở Redis, không ở DB (theo data-model.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNT_DATABASE_URL")
}

/// D3: vai trò là TẬP HỢP — một user có thể vừa player vừa provider.
enum UserRole {
  player
  provider
  admin
}

enum UserStatus {
  active
  locked
}

enum VerificationChannel {
  email
  phone
}

enum ProfileVisibility {
  public
  private
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  /// D3: enum đơn giá trị -> tập hợp vai trò.
  roles        UserRole[]
  verified     Boolean    @default(false)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  playerProfile  PlayerProfile?
  verifications  Verification[]
  passwordResets PasswordReset[]
  auditsAsTarget AccountAudit[] @relation("AuditTarget")

  @@map("users")
}

model PlayerProfile {
  userId      String            @id
  user        User              @relation(fields: [userId], references: [id])
  displayName String
  avatarUrl   String?
  preferences Json?
  visibility  ProfileVisibility @default(public)

  @@map("player_profiles")
}

model Verification {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  channel    VerificationChannel
  code       String
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("verifications")
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  token      String
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("password_resets")
}

model AccountAudit {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetUserId String
  target       User     @relation("AuditTarget", fields: [targetUserId], references: [id])
  reason       String?
  ts           DateTime @default(now())

  @@map("account_audits")
}
