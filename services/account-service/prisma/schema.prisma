// account-service — Prisma schema (schema-per-service, D17/ADR 0004).
// G0: áp lược đồ theo docs/architecture/data-model.md §1 + decision-log.md §5.
// Bất biến: service này CHỈ định nghĩa/đụng schema "account" của chính nó;
// không FK, không model tham chiếu bảng của service khác.
// Token blacklist (đăng xuất/thu hồi) để ở Redis, không ở DB (theo data-model.md).

generator client {
  provider = "prisma-client-js"
  // Bắt buộc chỉ định output riêng: npm workspaces hoist @prisma/client lên
  // node_modules gốc, nên nếu để mặc định, service generate sau sẽ GHI ĐÈ
  // client (và model) của service generate trước — phát hiện lúc làm G1.
  output = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNT_DATABASE_URL")
}

/// D3: vai trò là TẬP HỢP — một user có thể vừa player vừa provider.
enum UserRole {
  player
  provider
  admin
}

enum UserStatus {
  active
  locked
}

enum VerificationChannel {
  email
  phone
}

enum ProfileVisibility {
  public
  private
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  /// D3: enum đơn giá trị -> tập hợp vai trò.
  roles        UserRole[]
    verified     Boolean    @default(false)
    status       UserStatus @default(active)
    accountLockVersion Int  @default(0)
    createdAt    DateTime   @default(now())

  playerProfile  PlayerProfile?
  verifications  Verification[]
  passwordResets PasswordReset[]
  auditsAsTarget AccountAudit[] @relation("AuditTarget")

  @@map("users")
}

model PlayerProfile {
  userId      String            @id
  user        User              @relation(fields: [userId], references: [id])
  displayName String
  avatarUrl   String?
  preferences Json?
  visibility  ProfileVisibility @default(public)

  @@map("player_profiles")
}

model Verification {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  channel    VerificationChannel
  code       String
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("verifications")
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  token      String
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("password_resets")
}

model AccountAudit {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetUserId String
  target       User     @relation("AuditTarget", fields: [targetUserId], references: [id])
  reason       String?
  ts           DateTime @default(now())

  @@map("account_audits")
}

/// G1: bảng hạ tầng Outbox (data-model.md §7) — ghi cùng transaction với thay
/// đổi domain, relay publish lên RabbitMQ, đánh dấu publishedAt để không phát
/// trùng. Sự kiện phát: UserRegistered (ACC-02), AccountLocked (ACC-08, dùng
/// chung cho cả khóa/khôi phục qua trường `locked` trong payload).
model Outbox {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

/// G1: idempotency cho consumer CHÍNH account-service (nếu account-service
/// tự tiêu thụ sự kiện của mình trong tương lai). Không dùng để dedupe phía
/// finance/venue-booking — đó là ProcessedEvent riêng của schema họ.
model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("processed_events")
}
